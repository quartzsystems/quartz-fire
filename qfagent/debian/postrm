#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Drop our entry from the vyos-1x xml_ref cache (mirror of the
        # postinst registration).
        XML_REF=/usr/lib/python3/dist-packages/vyos/xml_ref
        if [ -f "$XML_REF/update_cache.py" ]; then
            rm -f "$XML_REF"/pkg_cache/quartzfire_qfagent_cache.py*
            (cd "$XML_REF" && python3 update_cache.py) 2>/dev/null || true
            systemctl try-restart vyos-configd 2>/dev/null || true
        fi
        ;;
esac

# The device identity under /config/quartzfire/qfagent is deliberately NOT
# removed on purge: /config survives image upgrades by design, and wiping an
# enrolled identity belongs to the operator ('qf identity regenerate' /
# 'qf prepare-template'), not to package management.

#DEBHELPER#

exit 0
