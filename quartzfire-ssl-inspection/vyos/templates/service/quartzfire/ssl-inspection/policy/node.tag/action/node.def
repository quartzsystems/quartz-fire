type: txt
help: Whether matching HTTPS is decrypted (inspect) or explicitly left alone (splice)
default: inspect
syntax:expression: $VAR(@) in "inspect", "splice" ; "action must be inspect or splice"
allowed: echo inspect splice
val_help: inspect; Decrypt and inspect matching HTTPS (ssl_bump)
val_help: splice; Explicit do-not-inspect carve-out (evaluated before inspects)
