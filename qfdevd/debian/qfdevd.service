[Unit]
Description=QuartzFire device/client monitoring daemon (qfdevd)
Documentation=file:/usr/share/doc/qfdevd/design.md
# /config mounts late on VyOS (vyos-router is Type=simple), so `After=` does not
# wait for the bind mount; qfdevd polls for it itself before opening the DB. We
# only need networking up so `ip`/`conntrack` have interfaces to report on.
After=network-pre.target vyos-router.service
Wants=network-pre.target

[Service]
Type=notify
NotifyAccess=main
# Create /config/quartzfire before the sandboxed daemon starts. The `+` runs
# this as root OUTSIDE the ProtectSystem=strict namespace: with ProtectSystem=
# strict, systemd only sets up the ReadWritePaths= writable bind below when the
# directory already exists at namespace construction. On a fresh install it does
# not, so /config is read-only inside the daemon's namespace and its own mkdir
# fails (EROFS) — it exits before signalling READY and this unit restart-loops.
# init-store waits for the (late) /config mount, then creates the dir group-
# writable, so the main ExecStart's namespace picks up the writable bind.
ExecStartPre=+/usr/sbin/qfdevd --config /etc/qfdevd/qfdevd.toml init-store
# Enable conntrack byte accounting HERE, not just via the sysctl.d drop-in: the
# `net.netfilter.nf_conntrack_acct` key only exists once nf_conntrack is loaded,
# and systemd-sysctl runs at early boot before VyOS loads conntrack — so the
# boot-time write silently misses and accounting stays off (kernel default 0),
# leaving every Usage figure empty. Load the module ourselves and set it, as
# root outside the sandbox (`+`). `sh -c … || true` keeps a container/dev box
# where this is unavailable from blocking startup.
ExecStartPre=+/bin/sh -c 'modprobe nf_conntrack 2>/dev/null || true; sysctl -w net.netfilter.nf_conntrack_acct=1 >/dev/null 2>&1 || true'
ExecStart=/usr/sbin/qfdevd --config /etc/qfdevd/qfdevd.toml run
Restart=on-failure
RestartSec=2
WatchdogSec=45
TimeoutStopSec=15
# The mount wait (bounded to 120s) now happens in the ExecStartPre init-store
# step; the main process re-checks but finds the mount already up, so the two do
# not stack. Budget covers ExecStartPre's worst case plus the daemon's own
# startup with headroom, so a genuinely slow mount never trips the start timeout.
TimeoutStartSec=180

# Dedicated unprivileged identity. Joins the `quartzfire` group so the DB it
# creates under /config can be handed to the (DynamicUser) WebUI backend, which
# is also a member of that group.
User=qfdevd
Group=qfdevd
SupplementaryGroups=quartzfire

# conntrack -L/-E (ctnetlink) needs NET_ADMIN; the neighbor table and Kea lease
# CSV are read without privilege.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# Runtime dir for status.json — 0755 so the unprivileged WebUI can read it.
RuntimeDirectory=qfdevd
RuntimeDirectoryMode=0755
ConfigurationDirectory=qfdevd

# The device inventory lives under /config (persists across image upgrades).
# `-` tolerates absence on dev boxes without /config.
ReadWritePaths=-/config/quartzfire
# ProtectKernelTunables= mounts /proc/sys read-only; punch a narrow writable
# hole for exactly the conntrack accounting sysctl so the daemon can re-assert
# it at runtime (vyos-router, being Type=simple, applies config after our
# ExecStartPre and races it back to 0 — see conntrack_snapshot_loop). `-`
# tolerates its absence before nf_conntrack loads; the ExecStartPre modprobe
# above ensures it exists when the main process's namespace is built.
ReadWritePaths=-/proc/sys/net/netfilter/nf_conntrack_acct

# Sandboxing.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# ctnetlink (NET_ADMIN) is AF_NETLINK; the Kea control socket is AF_UNIX.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

# Structured logs to the journal under this identifier.
SyslogIdentifier=qfdevd

[Install]
WantedBy=multi-user.target
