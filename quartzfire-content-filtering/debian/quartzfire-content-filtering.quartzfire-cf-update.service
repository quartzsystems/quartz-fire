[Unit]
Description=Update QuartzFire content-filter blocklists (UT1)
Documentation=file:/usr/share/doc/quartzfire-content-filtering/design.md
Wants=network-online.target
After=network-online.target vyos-router.service
# Triggered per WebUI request; a burst must not trip the start-rate limit and
# take the request path watcher down with it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/quartzfire/qfcf-update
# Download + extract + verify + atomic swap of the full UT1 tarball can take a
# while on a slow uplink.
TimeoutStartSec=1800
RuntimeDirectory=quartzfire-content-filtering
RuntimeDirectoryPreserve=yes

# No [Install]: started by the update timer (which covers boot via OnBootSec) and
# the WebUI request path unit.
